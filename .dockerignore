# Keep the build context to what the Dockerfile copies: requirements.txt and src/.

# VCS / CI
.git/
.gitignore
.github/

# Local config, secrets and state (mounted at runtime, never baked into the image)
config.yaml
config.local.yaml
.env
.env.*
data/
logs/
*.log
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python artifacts
__pycache__/
*.py[cod]
build/
dist/
*.zip
verifyarr.spec
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Tests, docs and tooling not needed at runtime
tests/
scripts/
pytest.ini
pyproject.toml
requirements-dev.txt
README.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
LICENSE
docker-compose.yml
Dockerfile
.dockerignore
.idea/
.vscode/
.DS_Store
Thumbs.db
