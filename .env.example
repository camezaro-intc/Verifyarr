# Copy to .env. Environment variables override values in config.yaml.
# Nested keys use a double underscore: VERIFYARR_<SECTION>__<KEY>

# Location of the YAML config (defaults to ./config.yaml)
# VERIFYARR_CONFIG=/app/config.yaml

# Secrets (preferred over committing them to config.yaml)
VERIFYARR_RADARR__API_KEY=YOUR_RADARR_API_KEY
VERIFYARR_SONARR__API_KEY=YOUR_SONARR_API_KEY
VERIFYARR_JELLYFIN__API_KEY=YOUR_JELLYFIN_API_KEY
VERIFYARR_NOTIFICATIONS__DISCORD_WEBHOOK_URL=

# Safety switch: keep true until you trust the results
VERIFYARR_VERIFICATION__DRY_RUN=true

# Docker only: user/group the container runs as (needs read access to the media mount)
PUID=1000
PGID=1000
TZ=UTC
